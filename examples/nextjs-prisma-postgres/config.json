{
  "version": 1,
  "project": {
    "name": "my-app"
  },
  "sampling": {
    "mode": "auto",
    "max": 45,
    "from": null,
    "to": null,
    "branch": null,
    "uiPaths": [
      "app"
    ],
    "everyN": 25,
    "auto": {
      "churn": 2500,
      "minGapDays": 2
    }
  },
  "capture": {
    "viewports": {
      "desktop": {
        "width": 1440,
        "height": 900,
        "colorScheme": "dark"
      },
      "mobile": {
        "width": 390,
        "height": 844,
        "colorScheme": "dark"
      }
    },
    "signedOut": true,
    "states": {
      "enabled": true,
      "maxClicks": 14,
      "maxPerPage": 10,
      "sectionChange": 0.2
    },
    "locale": "en-US",
    "colorScheme": "dark",
    "include": [],
    "exclude": [],
    "parallel": 3
  },
  "run": {
    "concurrency": 4,
    "basePort": 4100,
    "keepWorktrees": false,
    "readyPath": "/login"
  },
  "login": null,
  "lineage": {
    "pagePaths": [
      "app"
    ]
  }
}
